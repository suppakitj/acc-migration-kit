# ============================================================================
#  .env.example — คัดลอกเป็น .env แล้วเติมค่าจริง
#  !! ห้าม commit ไฟล์ .env เข้า git เด็ดขาด — เพิ่มใน .gitignore แล้ว !!
#
#  วิธี generate ค่าสุ่ม:
#     openssl rand -base64 48 | tr -d '\n'
#  วิธี generate ANON_KEY / SERVICE_ROLE_KEY จาก JWT_SECRET:
#     https://supabase.com/docs/guides/self-hosting#api-keys  (หรือใช้ script gen-keys.sh)
#
#  >>> ค่า default ที่มาพร้อม supabase/docker/.env.example เป็น demo credential
#      ที่เผยแพร่สาธารณะ ถ้าไม่เปลี่ยนทุกตัว ระบบจะถูกยึดภายในไม่กี่ชั่วโมง <<<
# ============================================================================

############ Postgres ########################################################
POSTGRES_PASSWORD=            # openssl rand -base64 32
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############ JWT / API keys ##################################################
JWT_SECRET=                   # ≥ 32 ตัวอักษร
ANON_KEY=                     # JWT role=anon   (ฝังใน frontend — ถือว่าเป็นข้อมูลสาธารณะ)
SERVICE_ROLE_KEY=             # JWT role=service_role  (ความลับสูงสุด — server เท่านั้น)

############ Studio / Dashboard ##############################################
DASHBOARD_USERNAME=acc-admin
DASHBOARD_PASSWORD=           # openssl rand -base64 24
SECRET_KEY_BASE=              # openssl rand -base64 64
VAULT_ENC_KEY=                # 32 ตัวอักษรพอดี

############ URL ############################################################
APP_ORIGIN=https://accoperation.com
SITE_URL=https://accoperation.com
API_EXTERNAL_URL=https://accoperation.com
SUPABASE_PUBLIC_URL=https://accoperation.com

############ SMTP (Microsoft 365 ของบริษัท) ##################################
SMTP_USER=noreply@accconsultingservice.com
SMTP_PASS=                    # app password — ไม่ใช่รหัสผ่านบัญชีจริง
SMTP_ADMIN_EMAIL=noreply@accconsultingservice.com

############ Integrations ที่ต้องย้ายมาจาก Base44 ############################
# LLM สำหรับ InvokeLLM / ExtractDataFromUploadedFile (เดิม Base44 จัดให้)
ANTHROPIC_API_KEY=

# Google Drive — ต้องสร้าง OAuth client เองใน Google Cloud Console
# scope: https://www.googleapis.com/auth/drive, .../userinfo.email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# วันหยุดราชการ (เดิมอ่านจาก Deno.env ของ Base44)
HOLIDAY_API_KEY=

############ Backup #########################################################
RESTIC_REPOSITORY=b2:acc-ops-backup:/pg
RESTIC_PASSWORD=              # กู้คืนไม่ได้ถ้าลืม — เก็บใน password manager ของบริษัท
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

############ หมายเหตุ #######################################################
# LINE channel access token / secret, credential_encryption_key และ Manus API key
# เก็บในตาราง public.app_secret (service_role เข้าถึงได้เท่านั้น) ไม่ใช่ในไฟล์นี้
# — เพราะผู้ใช้ในระบบต้องแก้ได้จากหน้า AppSettings โดยไม่ต้อง restart container
